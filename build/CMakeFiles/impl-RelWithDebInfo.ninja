  TARGET_PDB = glad.a.dbg
  TARGET_SUPPORT_DIR = _deps\glad-build\CMakeFiles\glad.dir

build ap2.exe$:RelWithDebInfo: phony bin/RelWithDebInfo/ap2.exe

